# Copy settings into .env.local. Never use a VITE_ prefix for secrets.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/cvforge
CLIENT_ORIGIN=http://localhost:5173
# Required in production: use a random secret of at least 32 characters.
JWT_SECRET=
# Optional in production. Set both to create an administrator on first startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Used for the single retry after a temporary provider error. Leave empty to retry the primary model.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Route browser calls through Vite's API proxy during development and preview.
VITE_API_URL=/api
