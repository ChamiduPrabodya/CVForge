{
  "name": "cvforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "vite --config client/vite.config.ts",
    "dev:api": "node --watch server/index.js",
    "reset:admin": "node scripts/reset-admin-password.js",
    "build": "npm run typecheck && vite build --config client/vite.config.ts",
    "preview": "vite preview --config client/vite.config.ts",
    "typecheck": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p client/tsconfig.node.json",
    "test": "node --test server/tests/*.test.js client/tests/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "html2canvas": "latest",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "latest",
    "lucide-react": "latest",
    "mammoth": "^1.12.3",
    "mongoose": "^9.9.5",
    "pdfjs-dist": "^6.3.289",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
